root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Shared test fixtures are compared byte for byte.
[tests/data/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
